{
  "name": "engram",
  "version": "0.1.0",
  "description": "Production agent memory infrastructure with 3-tier memory, selective recall, and policy-driven forgetting",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "engram": "dist/cli.js",
    "engram-mcp": "dist/mcp/server.js",
    "engram-api": "dist/api/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node dist/mcp/server.js",
    "api": "node dist/api/server.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "fastify": "^5.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "keywords": [
    "agent",
    "memory",
    "ai",
    "llm",
    "sqlite",
    "episodic",
    "semantic",
    "recall",
    "forgetting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Angelopvtac/engram"
  }
}
